# App URL used by Auth.js. Use your deployed HTTPS URL in production.
AUTH_URL=http://localhost:3000
AUTH_SECRET=

# Google OAuth Web application credentials.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# PostgreSQL database used for Auth.js users/sessions and role persistence.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/paytm_pwa?schema=public"

# Server-only OpenAI credentials for Point & Ask AI and future realtime vision sessions.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2
OPENAI_VISION_MODEL=gpt-4.1-mini

# Point & Ask AI falls back to mock when OPENAI_API_KEY is empty or an API call fails.
# Set this to force only when you want to skip OpenAI even with a configured key.
NEXT_PUBLIC_ENABLE_MOCK_MODE=true
